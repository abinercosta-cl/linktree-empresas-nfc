# Copie para .env e preencha com os valores reais. Nunca versione o .env.

# Neon Postgres: conexão com pooling, usada pela aplicação
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres: conexão direta, sem pooling, usada pelas migrations do Prisma
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require"

# URL pública do site, usada em OpenGraph, QR Code e vCard.
# É fixada no build: defina no provedor de deploy antes de rodar o build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Segredo da autenticação do painel administrativo (ainda não implementado).
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"
